# Copy to your process manager / container env. Never commit real values.
NODE_ENV=production
PORT=3100
# 32+ random characters, e.g. `openssl rand -base64 48`. Required in production.
PORTAL_SECRET=
# Claude API key for evaluations (the portal runs without it; evaluations are disabled).
ANTHROPIC_API_KEY=
# Comma-separated emails that become admins when they register.
PORTAL_ADMIN_EMAILS=
# Where accounts, the DB and every user's career-ops files live. Back this up; it holds PII.
PORTAL_DATA_DIR=/data
# Set to 1 only behind a TLS-terminating reverse proxy (nginx, Caddy, a load balancer).
PORTAL_TRUST_PROXY=1
# Optional tuning (defaults shown)
# PORTAL_MODEL=claude-opus-5-5
# PORTAL_EFFORT=high
# PORTAL_EVAL_CONCURRENCY=2
# PORTAL_DAILY_EVAL_QUOTA=10
# PORTAL_ALLOW_REGISTRATION=1
# Only if outbound traffic goes through an HTTP(S) proxy (the scanners refuse proxied egress otherwise):
# CAREER_OPS_TRUST_PROXY_EGRESS=1
